#!/usr/bin/env bash

# -- Install the two toolchains needed: oss-cad-suite and openxc7.
# -- Thin driver that delegates to the standalone installers (which share
# -- lib/common.sh for platform detection and version pins). Kept in sync
# -- with install.sh -- both are valid entry points.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Install oss-cad-suite
bash "$HERE/install-oss-cad-suite.sh"

# --- Install openxc7
bash "$HERE/install-openxc7.sh"
