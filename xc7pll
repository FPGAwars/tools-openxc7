#!/usr/bin/env python3
"""xc7pll -- PLL parameter calculator for Xilinx 7-series (PLLE2_BASE).

The xc7 counterpart of icepll (ice40) and ecppll (ecp5): given the input
clock and up to six requested output frequencies, search the legal
(DIVCLK_DIVIDE, CLKFBOUT_MULT, CLKOUT*_DIVIDE) space of a PLLE2 and emit
a ready-to-instantiate Verilog module (default, like ecppll/gowin_pll)
or a parameter report (--report).

Hard limits implemented (7-series, conservative -1 speed grade; DS181):

    CLKIN            19 .. 800 MHz    (below 19 MHz a PLLE2 cannot lock:
                                       e.g. the Arty S7-50 12 MHz clock
                                       needs an MMCME2 -- not covered yet)
    PFD  = CLKIN/D   19 .. 450 MHz
    VCO  = CLKIN*M/D 800 .. 1600 MHz
    M (CLKFBOUT_MULT)     2 .. 64
    D (DIVCLK_DIVIDE)     1 .. 56
    O (CLKOUTn_DIVIDE)    1 .. 128
    fOUTn = VCO / On

Usage:
    xc7pll -i 100 -o 65                    # report best config
    xc7pll -i 100 -o 65 -o 25 -m          # emit a Verilog module
    xc7pll -i 100 -o 65 -m -n my_pll -f pll.v
"""

import argparse
import sys

VERSION = "1.1.0"
CREDITS = (
    f"xc7pll {VERSION} — PLL parameter calculator for Xilinx 7-series\n"
    "Part of tools-openxc7 (FPGAwars), the openXC7 toolchain package for apio.\n"
    "For the openXC7 project's toolchain. Electrical limits from Xilinx DS181.\n"
    "License: GPL-3.0."
)

CLKIN_MIN, CLKIN_MAX = 19.0, 800.0
PFD_MIN, PFD_MAX = 19.0, 450.0
VCO_MIN, VCO_MAX = 800.0, 1600.0
M_MIN, M_MAX = 2, 64
D_MIN, D_MAX = 1, 56
O_MIN, O_MAX = 1, 128
MAX_OUTPUTS = 6


def solve(fin, targets):
    """Best (D, M, [O...]) for the requested outputs, or None."""
    best = None
    for div in range(D_MIN, D_MAX + 1):
        pfd = fin / div
        if pfd < PFD_MIN:
            break  # growing D only lowers PFD further
        if pfd > PFD_MAX:
            continue
        for mult in range(M_MIN, M_MAX + 1):
            vco = fin * mult / div
            if vco < VCO_MIN:
                continue
            if vco > VCO_MAX:
                break  # growing M only raises VCO further
            odivs, err = [], 0.0
            for ftgt in targets:
                odiv = min(max(round(vco / ftgt), O_MIN), O_MAX)
                odivs.append(odiv)
                err += abs(vco / odiv - ftgt) / ftgt
            # tie-breaks: exactness first, then higher VCO (lower jitter),
            # then smaller D (higher PFD)
            key = (err, -vco, div)
            if best is None or key < best[0]:
                best = (key, div, mult, odivs, vco)
    if best is None:
        return None
    _, div, mult, odivs, vco = best
    return div, mult, odivs, vco


def report(fin, targets, div, mult, odivs, vco):
    lines = [
        f"input:            {fin:.6g} MHz",
        f"DIVCLK_DIVIDE:    {div}   (PFD {fin / div:.6g} MHz)",
        f"CLKFBOUT_MULT:    {mult}  (VCO {vco:.6g} MHz)",
    ]
    for n, (ftgt, odiv) in enumerate(zip(targets, odivs)):
        fach = vco / odiv
        ppm = (fach - ftgt) / ftgt * 1e6
        mark = "exact" if abs(ppm) < 0.5 else f"{ppm:+.0f} ppm"
        lines.append(
            f"CLKOUT{n}_DIVIDE:   {odiv}  ->  {fach:.6g} MHz "
            f"(requested {ftgt:.6g} MHz, {mark})")
    return "\n".join(lines)


def module(fin, targets, div, mult, odivs, vco, name):
    outs = ", ".join(f"clk_out{n}" for n in range(len(targets)))
    ports = "\n".join(
        f"    output wire clk_out{n},   // {vco / o:.6g} MHz"
        for n, o in enumerate(odivs))
    # last parameter in the instantiation: no trailing comma after the
    # final CLKOUTn_DIVIDE (strict Verilog rejects it)
    params = ",\n".join(
        f"        .CLKOUT{n}_DIVIDE({o})"
        for n, o in enumerate(odivs))
    # unused CLKOUT pins are connected empty so the module passes
    # apio lint out of the box (icepll/ecppll leave them out and fail,
    # see apio issues 669/670)
    conns = "\n".join(
        f"        .CLKOUT{n}({f'clk_out{n}_unbuf' if n < len(targets) else ''}),"
        for n in range(6))
    bufgs = "\n".join(
        f"    BUFG bufg_out{n} (.I(clk_out{n}_unbuf), .O(clk_out{n}));"
        for n in range(len(targets)))
    unbufs = ", ".join(f"clk_out{n}_unbuf" for n in range(len(targets)))
    return f"""`default_nettype none

// Generated by xc7pll: PLLE2_BASE, input {fin:.6g} MHz
// {report(fin, targets, div, mult, odivs, vco).replace(chr(10), chr(10) + "// ")}
module {name} (
    input  wire clk_in,      // {fin:.6g} MHz
{ports}
    output wire locked
);

    wire clk_fb, {unbufs};

    PLLE2_BASE #(
        .CLKIN1_PERIOD({1000.0 / fin:.3f}),
        .DIVCLK_DIVIDE({div}),
        .CLKFBOUT_MULT({mult}),
{params}
    ) pll (
        .CLKIN1(clk_in),
        .CLKFBOUT(clk_fb),
        .CLKFBIN(clk_fb),
{conns}
        .LOCKED(locked),
        .RST(1'b0),
        .PWRDWN(1'b0)
    );

{bufgs}

endmodule
"""


def main(argv=None):
    p = argparse.ArgumentParser(
        prog="xc7pll", description=__doc__.splitlines()[0],
        epilog=CREDITS, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-v", "--version", action="version", version=CREDITS)
    p.add_argument("-i", "--input", type=float, required=True,
                   metavar="MHZ", help="input clock frequency (MHz)")
    p.add_argument("-o", "--output", type=float, action="append",
                   required=True, metavar="MHZ",
                   help="requested output frequency (repeatable, up to 6)")
    p.add_argument("-r", "--report", action="store_true",
                   help="print the parameter report instead of the module")
    # Deprecated no-op: the module is now the default output (apio#915,
    # consistency with ecppll/gowin_pll); kept so the 2026-08-07 usage
    # keeps working.
    p.add_argument("-m", "--module", action="store_true",
                   help=argparse.SUPPRESS)
    p.add_argument("-n", "--name", default="pll",
                   help="module name (default: pll)")
    p.add_argument("-f", "--file", metavar="PATH",
                   help="write the output to a file instead of stdout")
    args = p.parse_args(argv)

    fin, targets = args.input, args.output
    if not CLKIN_MIN <= fin <= CLKIN_MAX:
        extra = (" (an MMCME2 can lock from 10 MHz; not supported yet)"
                 if fin < CLKIN_MIN else "")
        p.error(f"input {fin:g} MHz outside the PLLE2 range "
                f"[{CLKIN_MIN:g}, {CLKIN_MAX:g}] MHz{extra}")
    if len(targets) > MAX_OUTPUTS:
        p.error(f"a PLLE2 has {MAX_OUTPUTS} outputs, {len(targets)} requested")
    lo, hi = VCO_MIN / O_MAX, VCO_MAX / O_MIN
    for f in targets:
        if not lo <= f <= hi:
            p.error(f"output {f:g} MHz unreachable (PLLE2 span "
                    f"[{lo:.3g}, {hi:.6g}] MHz)")

    got = solve(fin, targets)
    if got is None:
        p.error("no legal PLLE2 configuration found for that combination")
    div, mult, odivs, vco = got

    text = (report(fin, targets, div, mult, odivs, vco)
            if args.report else module(fin, targets, div, mult, odivs, vco, args.name))
    if args.file:
        with open(args.file, "w") as fh:
            fh.write(text if text.endswith("\n") else text + "\n")
    else:
        print(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
